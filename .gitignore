.env
.google_cache/
.ms_cache.bin
.spotify_cache
.certs/
jarvis.log
__pycache__/
*.pyc

# Multi-user build: real users' accounts + Google tokens live here — never
# commit this, same reasoning as .env/.google_cache above. The trailing *
# also covers SQLite's WAL-mode siblings (users.db-wal/-shm) if the local
# fallback path (no DATABASE_URL set) ever runs with journal_mode=WAL.
users.db*
